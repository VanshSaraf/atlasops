{
  "name": "atlasops-platform",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w & node --watch dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:samples": "node scripts/validate-sample-repos.js",
    "frontend:build": "npm --prefix frontend run build",
    "verify": "node scripts/verify.js",
    "verify:all": "node scripts/verify.js --all"
  },
  "keywords": [
    "cicd",
    "devops",
    "reliability-automation",
    "ai-ops"
  ],
  "author": "YOUR_NAME_OR_ORG",
  "license": "ISC",
  "description": "AtlasOps backend for AI-powered CI/CD recovery and delivery reliability workflows",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "simple-git": "^3.31.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
